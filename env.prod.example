# 华康电器连锁积分小程序 - 生产环境配置模板
# 请复制此文件为 .env.prod 并填写实际值

# ==================== 数据库配置 ====================
# MySQL Root密码（仅用于初始化）
DB_ROOT_PASSWORD=

# 应用数据库配置
DB_NAME=hk_electronics
DB_USERNAME=hk_prod
DB_PASSWORD=

# ==================== Redis配置 ====================
REDIS_PASSWORD=

# ==================== JWT配置 ====================
# 使用以下命令生成强密钥：openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=7200000

# ==================== 阿里云OSS配置 ====================
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_DOMAIN=
OSS_PATH_PREFIX=images/

# ==================== 微信小程序配置 ====================
WECHAT_APPID=
WECHAT_SECRET=

# ==================== 服务器配置 ====================
# 如果需要修改端口，请同时修改Nginx配置
ADMIN_PORT=8080
MINIAPP_PORT=8081
