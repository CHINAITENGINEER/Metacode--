<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.huakang</groupId>
    <artifactId>huakang-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>华康电器连锁积分小程序 - 父模块</name>
    <description>华康会员积分及商品展示小程序后端系统</description>

    <modules>
        <module>huakang-common</module>
        <module>huakang-mapper</module>
        <module>huakang-service</module>
        <module>huakang-admin</module>
        <module>huakang-miniapp</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Spring Boot版本 -->
        <spring-boot.version>3.1.5</spring-boot.version>
        <!-- MyBatis-Plus版本 -->
        <mybatis-plus.version>3.5.8</mybatis-plus.version>
        <!-- Knife4j版本 -->
        <knife4j.version>4.4.0</knife4j.version>
        <!-- Hutool工具类版本 -->
        <hutool.version>5.8.23</hutool.version>
        <!-- JWT版本 -->
        <jwt.version>0.12.3</jwt.version>
        <!-- 阿里云OSS版本 -->
        <aliyun-oss.version>3.17.4</aliyun-oss.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 项目内部模块 -->
            <dependency>
                <groupId>com.huakang</groupId>
                <artifactId>huakang-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.huakang</groupId>
                <artifactId>huakang-mapper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.huakang</groupId>
                <artifactId>huakang-service</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
